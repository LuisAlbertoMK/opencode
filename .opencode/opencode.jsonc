{
  "$schema": "https://opencode.ai/config.json",

  // --- OPTIMIZACIÓN DE RECURSOS vMK ---
  // Ciclo de auto-mejora 2026-06-18: reducir CPU/RAM/GPU

  // Compactación temprana: menos tokens en contexto = menos RAM + CPU
  "compaction": {
    "auto": true,
    "prune": true,
    "keep": { "tokens": 4000 },
    "buffer": 10000
  },

  // Experimental: reducir FPS, concurrencia, cachés
  "experimental": {
    "tui_fps": 15,
    "tool_concurrency": 1,
    "lru_cache_size": 10,
    "lru_cache_ttl_ms": 1000,
    "delta_coalesce_ms": 200,
    "mcp_timeout": 30000
  },

  // Tool output truncado más agresivo
  "tool_output": {
    "max_lines": 1000,
    "max_bytes": 25600
  },

  // Imágenes: reducir dimensión máxima y peso
  "attachments": {
    "image": {
      "auto_resize": true,
      "max_width": 1000,
      "max_height": 1000,
      "max_base64_bytes": 1048576
    }
  },

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder:3b": {
          "name": "Qwen 2.5 Coder 3B",
          "tool_call": true,
          "limit": {
            "context": 16384,
            "output": 4096
          }
        },
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B",
          "tool_call": true,
          "limit": {
            "context": 16384,
            "output": 4096
          }
        },
        "deepseek-coder-v2": {
          "name": "DeepSeek Coder V2",
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    }
  },
  "permission": {},
  "mcp": {
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "engram": {
      "command": ["engram", "mcp", "--tools=agent"],
      "type": "local"
    }
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false
  }
}
