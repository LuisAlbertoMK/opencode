{
  "$schema": "https://opencode.ai/config.json",
  "tools": {
    "github-triage": true,
    "github-pr-search": true
  },
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 10240
  },
  "mcp": {
    "codebase-memory": {
      "type": "local",
      "command": ["codebase-memory-mcp"],
      "enabled": true,
      "timeout": 30000,
      "truncateLimit": 8192
    },
    "engram": {
      "type": "local",
      "command": ["engram", "mcp", "--tools=agent"],
      "enabled": true,
      "timeout": 120000,
      "truncateLimit": 4096
    }
  },
  "agent": {
    "gentleman-vMK": {
      "description": "Senior Architect mentor - helpful first, challenging when it matters",
      "mode": "primary",
      "prompt": "{file:../AGENTS.md}",
      "permission": {
        "edit": "allow",
        "write": "allow"
      }
    },
    "gentleman-deep": {
      "description": "Deep architecture and design agent",
      "mode": "primary",
      "prompt": "{file:../AGENTS.md}",
      "permission": {
        "edit": "allow",
        "write": "allow"
      }
    }
  }
}
