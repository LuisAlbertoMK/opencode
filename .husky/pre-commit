#!/bin/sh
set -e

# Pre-commit: auto-fix @opentui/core — debe usar catalog: (build lo pinnea, esto lo revierte)
if grep -q '"@opentui/core": "[^c]' packages/opencode/package.json 2>/dev/null; then
  echo "[pre-commit] AUTO-FIX: @opentui/core estaba PINNEADO -> cambiando a catalog:"
  sed -i 's/"@opentui\/core": *"[^c][^"]*"/"@opentui\/core": "catalog:"/' packages/opencode/package.json
  git add packages/opencode/package.json
  echo "[pre-commit] @opentui/core corregido a catalog: (build lo pinnea, pre-commit lo revierte)"
fi

# Pre-commit: typecheck parcial — solo packages con cambios staged
# Si no hay cambios en packages/, skip automático

CHANGED=$(git diff --cached --name-only --diff-filter=ACMR | grep '^packages/' | sed 's|^\(packages/[^/]*\)/.*|\1|' | sort -u)
TUI_CHANGED=$(git diff --cached --name-only --diff-filter=ACMR | grep '^packages/tui/' || true)

if [ -z "$CHANGED" ]; then
  echo "[pre-commit] No source changes in packages/ — skipping checks"
  exit 0
fi

# Pre-commit: orphan text check when TUI files changed (rápido: <1s)
if [ -n "$TUI_CHANGED" ]; then
  echo "[pre-commit] TUI files changed — running orphan text detection..."
  (cd packages/tui && bun test test/static/orphan-text.test.ts 2>&1 | tail -3 && echo "[pre-commit] Orphan text check OK")
fi

PACKAGES=$(echo "$CHANGED" | tr '\n' ',' | sed 's/,$//')
echo "[pre-commit] Changed packages: $PACKAGES"

if [ "$(echo "$PACKAGES" | tr ',' '\n' | wc -l)" -eq 1 ]; then
  # Single package — fastest path
  echo "[pre-commit] Running: bun turbo typecheck --filter='${PACKAGES%,}'"
  bun turbo typecheck --filter="${PACKAGES%,}" 2>&1 | tail -5
else
  # Multiple packages
  FILTERS=$(echo "$PACKAGES" | tr ',' '\n' | sed 's/^/--filter=/')
  echo "[pre-commit] Running: bun turbo typecheck $FILTERS"
  # shellcheck disable=SC2086
  bun turbo typecheck $FILTERS 2>&1 | tail -5
fi

echo "[pre-commit] typecheck parcial OK"
