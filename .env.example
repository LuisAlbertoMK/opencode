# OpenCode (vMK Fork) — Environment Variables
# Copy to .env and adjust for your environment

# === API Keys ===
# At least one LLM provider key is required
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# DEEPSEEK_API_KEY=...

# === Model Provider ===
# OPENCODE_PROVIDER=openai
# OPENCODE_MODEL=gpt-4o

# === Storage ===
# OPENCODE_DATA_DIR=~/.opencode

# === Telemetry ===
# OPENCODE_TELEMETRY=true

# === Development ===
# NODE_ENV=development
# DEBUG=opencode:*
